# Server
NODE_ENV=development
PORT=4000

# SQLite database path. Relative paths resolve from the backend/ directory.
# The default is data/credet.db.
DB_PATH=data/credet.db

# CORS: * for local development, or a comma-separated origin allow-list.
CORS_ORIGIN=*

# PDF engine (optional).
# By default, Puppeteer uses the Chrome for Testing browser downloaded by
# `npm install`. Set one of these paths to use a system Chrome/Chromium instead.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Only set this to 1 in a trusted container where the Chromium sandbox cannot run.
# PDF_NO_SANDBOX=0
