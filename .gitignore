# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!*/.env.example

# SQLite Databases & WAL journal files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
*/data/

# Application and runtime logs
logs/
*.log
# Keep the web log directory placeholder, but never commit runtime logs.
!web/logs/
web/logs/*
!web/logs/.gitignore
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tooling and local agent caches
.freebuff/
.impeccable/
.temp/
.tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor caches
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Build and framework artifacts (for Next.js & Expo upcoming phases)
.next/
out/
build/
dist/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo
